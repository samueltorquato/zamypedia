# Arquivo: local.properties.exemplo
# Copie as duas linhas abaixo para o arquivo local.properties (criado pelo Android Studio)
# e troque pelos valores do seu projeto no Supabase: Project Settings > API.
# Use SOMENTE a chave "anon public". Nunca coloque a chave "service_role" no app.
supabase.url=https://SEU-PROJETO.supabase.co
supabase.chave_publica=COLE_AQUI_A_CHAVE_ANON_PUBLIC
